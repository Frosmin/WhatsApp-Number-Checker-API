# Configuración del Pool de WhatsApp Number Checker

# Límite máximo de consultas por chip al día (0 = sin límite para pruebas de estrés)
MAX_DAILY_QUERIES_PER_NUMBER=1000

# Meta diaria global de consultas para el medidor visual
TARGET_DAILY_TOTAL=10000

# Milisegundos de espera/descanso por chip entre consultas (ej. 1000 = 1 segundo)
REQUEST_DELAY_MS=1000

# Dirección y puerto de escucha
HTTP_ADDR=127.0.0.1:8080

# Carpeta de sesiones SQLite
SESSIONS_DIR=data/sessions
